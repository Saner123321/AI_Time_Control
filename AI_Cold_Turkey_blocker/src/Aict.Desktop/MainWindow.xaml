<Window x:Class="Aict.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="专注计划 · 开发预览" Width="1180" Height="850" MinWidth="1000" MinHeight="700" Background="#F4F7FB">
  <Grid Background="#F4F7FB"><Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#152F45" Padding="28,15"><Grid><StackPanel><TextBlock Text="专注计划" Foreground="White" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="把计划交给后台，把注意力留给眼前。" Foreground="#BDD0DF" Margin="0,4,0,0"/></StackPanel><TextBlock Text="DEVELOPMENT PREVIEW" Foreground="#8AB5C8" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/></Grid></Border>
    <Border Grid.Row="1" Background="#FFF0D5" Padding="28,11"><TextBlock x:Name="ModeNotice" Text="开发预览：当前不会封锁应用或网站。后台为普通进程；尚未接入服务、真实使用统计或系统执行层。" TextWrapping="Wrap" Foreground="#805315"/></Border>
    <Grid Grid.Row="2" Margin="22,18"><Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="White" CornerRadius="10" Padding="16"><DockPanel>
        <StackPanel DockPanel.Dock="Top"><TextBlock Text="我的规则" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="这里显示后台当前配置" Foreground="{StaticResource Muted}" Margin="0,6,0,14"/><Button Content="＋ 新建规则草稿" Click="NewRule"/></StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,15,0,0"><Separator/><TextBlock x:Name="BackendState" Text="后台：连接中…" TextWrapping="Wrap" Margin="0,14,0,5"/><TextBlock x:Name="ExecutionText" Text="系统执行：未接入" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,5"/><TextBlock Text="使用额度：未知（未采集）" Foreground="{StaticResource Muted}" Margin="0,5"/><Button x:Name="DemoButton" Content="打开无害测试应用" Click="LaunchDemo" Visibility="Collapsed"/><Button Content="导出规则 JSON" Click="ExportJson"/><Button Content="导出额度 CSV" Click="ExportCsv"/></StackPanel>
        <ListBox x:Name="Rules" SelectionChanged="SelectRule" BorderThickness="0" Margin="0,8" Background="Transparent" HorizontalContentAlignment="Stretch"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,10"/><Setter Property="Margin" Value="0,2"/></Style></ListBox.ItemContainerStyle></ListBox>
      </DockPanel></Border>
      <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="22,16"><DockPanel>
        <StackPanel DockPanel.Dock="Top"><Grid><TextBlock Text="规则编辑" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="DraftState" Text="草稿仅在点击提交后保存" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></Grid>
          <Border Background="#EAF3F6" Padding="12" CornerRadius="6" Margin="0,12,0,8"><StackPanel><TextBlock x:Name="PendingText" Text="正在读取待生效修改…" TextWrapping="Wrap"/><WrapPanel><Button x:Name="ReviewButton" Content="查看冻结修改" Click="ReviewPending" IsEnabled="False"/><Button x:Name="CancelButton" Content="撤销待生效修改（保留原规则）" Click="CancelPending" IsEnabled="False"/></WrapPanel></StackPanel></Border>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom"><Separator Margin="0,10"/><WrapPanel><Button x:Name="SubmitButton" Content="提交完整修改" Background="#197D83" Foreground="White" Click="Submit" IsEnabled="False"/><Button Content="放弃草稿并重新读取" Click="ReloadDraft"/><Button Content="从草稿中删除此规则" Click="DeleteRule"/></WrapPanel><TextBlock x:Name="FooterNotice" Text="提交后按当前配置的延迟和锁定等待。关闭窗口不会停止后台预览进程。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
        <ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0"><StackPanel x:Name="Editor" IsEnabled="False">
          <TextBlock Text="规则名称"/><TextBox x:Name="RuleName"/><WrapPanel><CheckBox x:Name="Enabled" Content="启用此规则"/><CheckBox x:Name="LockWhile" Content="封锁条件满足时锁住修改"/></WrapPanel>
          <TextBlock Text="限制哪些内容" Style="{StaticResource Section}"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="应用"/><ComboBox x:Name="AppMode" SelectedIndex="0"><ComboBoxItem Content="不限制应用"/><ComboBoxItem Content="封锁选中的应用"/><ComboBoxItem Content="仅允许选中的应用"/></ComboBox>
              <ListBox x:Name="Applications" Height="76" BorderBrush="#CCD6E1"/><WrapPanel><Button Content="选择 EXE…" Click="AddApplication"/><Button Content="移除" Click="RemoveApplication"/></WrapPanel>
              <TextBlock Text="应用例外" Margin="0,8,0,0"/><ListBox x:Name="AppExceptions" Height="55" BorderBrush="#CCD6E1"/><WrapPanel><Button Content="添加例外…" Click="AddAppException"/><Button Content="移除" Click="RemoveAppException"/></WrapPanel>
              <TextBlock Text="按当前文件版本识别；软件更新后需重新选择。Store 应用尚未支持。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11"/>
            </StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="网站"/><ComboBox x:Name="SiteMode" SelectedIndex="1"><ComboBoxItem Content="不限制网站"/><ComboBoxItem Content="封锁这些域名"/><ComboBoxItem Content="仅允许这些域名"/></ComboBox><TextBox x:Name="Sites" AcceptsReturn="True" Height="114" VerticalScrollBarVisibility="Auto"/><TextBlock Text="域名例外"/><TextBox x:Name="SiteExceptions" AcceptsReturn="True" Height="63" VerticalScrollBarVisibility="Auto"/><TextBlock Text="每行一个域名，包含其子域。例如 bilibili.com；不要填写完整网址。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
          </Grid>
          <TextBlock Text="何时限制" Style="{StaticResource Section}"/><CheckBox x:Name="Always" Content="全天封锁（独立于额度）"/>
          <TextBlock Text="每周时段 · 结束时间早于开始时间时跨午夜" Foreground="{StaticResource Muted}" Margin="0,8"/><StackPanel x:Name="WindowsPanel"/><Button Content="＋ 添加每周时段" HorizontalAlignment="Left" Click="AddWindow"/>
          <WrapPanel Margin="0,8"><CheckBox x:Name="QuotaEnabled" Content="每日共享额度"/><TextBox x:Name="QuotaMinutes" Text="30" Width="66"/><TextBlock Text="分钟 · 当前预览不会采集实际用量" VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="8,0"/></WrapPanel>
          <WrapPanel><CheckBox x:Name="CycleEnabled" Content="循环计划"/><TextBlock Text="封锁" VerticalAlignment="Center"/><TextBox x:Name="BlockMinutes" Text="25" Width="60" Margin="6,4,6,10"/><TextBlock Text="分钟，休息" VerticalAlignment="Center"/><TextBox x:Name="RestMinutes" Text="5" Width="60" Margin="6,4,6,10"/><TextBlock Text="分钟" VerticalAlignment="Center"/></WrapPanel><TextBlock x:Name="CycleAnchor" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
          <TextBlock Text="整份配置的修改等待" Style="{StaticResource Section}"/><WrapPanel><TextBlock Text="新配置的延迟" VerticalAlignment="Center"/><TextBox x:Name="DelayHours" Text="24" Width="70" Margin="10,4,8,10"/><ComboBox x:Name="DelayUnit" SelectedIndex="1" Width="85"><ComboBoxItem Content="分钟"/><ComboBoxItem Content="小时"/></ComboBox><ComboBox x:Name="TimeZone" SelectedIndex="0" Width="150" Margin="22,4,0,10"><ComboBoxItem Content="上海时间"/><ComboBoxItem Content="UTC"/></ComboBox></WrapPanel>
          <TextBlock x:Name="DelayNotice" Text="本次修改等待多久，由后台当前配置决定。首次空白预览配置的延迟为 0；这里默认将后续修改设为 24 小时。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"/>
        </StackPanel></ScrollViewer>
      </DockPanel></Border>
    </Grid>
    <Border Grid.Row="3" Background="#E9EFF5" Padding="26,10"><TextBlock x:Name="Feedback" Text="正在连接后台预览…" TextWrapping="Wrap"/></Border>
  </Grid>
</Window>
