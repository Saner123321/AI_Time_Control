<Window x:Class="Aict.Beta.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="专注计划 · 自用测试版" Width="1180" Height="850" MinWidth="1000" MinHeight="700" Background="#F4F7FB">
  <Grid Background="#F4F7FB"><Grid.RowDefinitions><RowDefinition Height="90"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#152F45" Padding="28,15"><Grid><StackPanel><TextBlock Text="专注计划" Foreground="White" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="把计划交给后台，把注意力留给眼前。" Foreground="#BDD0DF" Margin="0,4,0,0"/></StackPanel><TextBlock Text="SELF-USE BETA" Foreground="#8AB5C8" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11"/></Grid></Border>
    <Border Grid.Row="1" Background="#FFF0D5" Padding="28,11"><TextBlock x:Name="ModeNotice" Text="规则交由后台执行。关闭界面不会解除限制；浏览器组件失联时，网站保护会限制受管理浏览器联网。" TextWrapping="Wrap" Foreground="#805315"/></Border>
    <Grid Grid.Row="2" Margin="22,18"><Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="White" CornerRadius="10" Padding="16"><DockPanel>
        <StackPanel DockPanel.Dock="Top"><WrapPanel><Button Content="浏览器设置" Click="BrowserSetup"/><Button Content="诊断/恢复" Click="Diagnostics"/></WrapPanel><TextBlock x:Name="RuleListCaption" Text="正在生效的规则" FontSize="18" FontWeight="SemiBold"/><WrapPanel><Button x:Name="CurrentViewButton" Content="正在生效" Click="ShowCurrentRules"/><Button x:Name="PendingViewButton" Content="待生效" Click="ShowPendingRules" IsEnabled="False"/></WrapPanel><TextBlock Text="收紧立即生效；放宽才等待" Foreground="{StaticResource Muted}" Margin="0,6,0,10"/><Button Content="＋ 新建规则草稿" Click="NewRule"/></StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,15,0,0"><Separator/><TextBlock x:Name="BackendState" Text="后台：连接中…" TextWrapping="Wrap" Margin="0,14,0,5"/><TextBlock x:Name="ExecutionText" Text="系统执行：未接入" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,5"/><TextBlock x:Name="UsageText" TextWrapping="Wrap" Text="用量：读取中…" Foreground="{StaticResource Muted}" Margin="0,5"/><Button x:Name="DemoButton" Content="打开无害测试应用" Click="LaunchDemo" Visibility="Collapsed"/><Button Content="查看使用统计" Click="Statistics"/><Button Content="导出规则 JSON" Click="ExportJson"/><Button Content="导出额度 CSV" Click="ExportCsv"/></StackPanel>
        <ListBox x:Name="Rules" SelectionChanged="SelectRule" BorderThickness="0" Margin="0,8" Background="Transparent" HorizontalContentAlignment="Stretch"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,10"/><Setter Property="Margin" Value="0,2"/></Style></ListBox.ItemContainerStyle></ListBox>
      </DockPanel></Border>
      <Border Grid.Column="2" Background="White" CornerRadius="10" Padding="22,16"><DockPanel>
        <StackPanel DockPanel.Dock="Top"><Grid><TextBlock Text="规则编辑" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="DraftState" Text="草稿仅在点击提交后保存" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></Grid>
          <Border Background="#EAF3F6" Padding="12" CornerRadius="6" Margin="0,12,0,8"><StackPanel><TextBlock x:Name="PendingText" Text="正在读取待生效修改…" TextWrapping="Wrap"/><WrapPanel><Button x:Name="ReviewButton" Content="查看完整待生效内容" Click="ReviewPending" IsEnabled="False"/><Button x:Name="CancelButton" Content="取消待生效修改（保留当前规则）" Click="CancelPending" IsEnabled="False"/></WrapPanel></StackPanel></Border>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom"><Separator Margin="0,10"/><WrapPanel><Button x:Name="SubmitButton" Content="提交完整修改" Background="#197D83" Foreground="White" Click="Submit" IsEnabled="False"/><Button Content="放弃草稿并重新读取" Click="ReloadDraft"/><Button Content="从草稿中删除此规则" Click="DeleteRule"/></WrapPanel><TextBlock x:Name="FooterNotice" Text="提交后按当前配置的延迟和锁定等待。关闭窗口不会停止后台服务。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
        <ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0"><StackPanel x:Name="Editor" IsEnabled="False">
          <TextBlock Text="规则名称"/><TextBox x:Name="RuleName"/><WrapPanel><CheckBox x:Name="Enabled" Content="启用此规则"/><CheckBox x:Name="LockWhile" Visibility="Collapsed"/></WrapPanel>
          <TextBlock Text="限制哪些内容" Style="{StaticResource Section}"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="应用"/><ComboBox x:Name="AppMode" SelectedIndex="0"><ComboBoxItem Content="不限制应用"/><ComboBoxItem Content="封锁选中的应用"/><ComboBoxItem Content="仅允许选中的应用"/></ComboBox>
              <ListBox x:Name="Applications" Height="76" BorderBrush="#CCD6E1"/><WrapPanel><Button Content="选择 EXE…" Click="AddApplication"/><Button Content="移除" Click="RemoveApplication"/></WrapPanel>
              <TextBlock Text="应用例外" Margin="0,8,0,0"/><ListBox x:Name="AppExceptions" Height="55" BorderBrush="#CCD6E1"/><WrapPanel><Button Content="添加例外…" Click="AddAppException"/><Button Content="移除" Click="RemoveAppException"/></WrapPanel>
              <TextBlock Text="按文件内容识别，改名或复制也会受限；更新后需重新选择。白名单保留系统和本软件必需项。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11"/>
            </StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="网站"/><ComboBox x:Name="SiteMode" SelectedIndex="1"><ComboBoxItem Content="不限制网站"/><ComboBoxItem Content="封锁这些网址"/><ComboBoxItem Content="仅允许这些网址"/></ComboBox><TextBox x:Name="Sites" AcceptsReturn="True" Height="114" VerticalScrollBarVisibility="Auto"/><TextBlock Text="网站例外 · 按用途整理" Margin="0,8,0,0"/><Border Background="#F0F6F8" Padding="10" CornerRadius="6"><StackPanel><TextBlock x:Name="ExceptionSummary" Text="尚未添加例外" TextWrapping="Wrap"/><Button Content="管理例外 · 备注 / 分组 / 搜索…" Click="ManageExceptions" HorizontalAlignment="Left"/><TextBlock Text="仅改备注和分组立即保存；新增或修改放行网址仍需等待。" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></StackPanel></Border><TextBox x:Name="SiteExceptions" Visibility="Collapsed" AcceptsReturn="True"/><TextBlock Text="域名包含子域；具体页面须与实际主机名一致（含 www）。支持 * 通配符，普通页面链接忽略查询参数。" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel>
          </Grid>
          <TextBlock Text="何时限制" Style="{StaticResource Section}"/><CheckBox x:Name="Always" Content="全天封锁（独立于额度）"/>
          <TextBlock Text="每周硬封锁时段 · 到点直接封锁，与额度独立" Foreground="{StaticResource Muted}" Margin="0,8"/><StackPanel x:Name="WindowsPanel"/><Button Content="＋ 添加每周硬封锁时段" HorizontalAlignment="Left" Click="AddWindow"/>
          <Border Background="#F0F6F8" Padding="12" Margin="0,10" CornerRadius="6"><StackPanel><CheckBox x:Name="QuotaEnabled" Content="启用可用时间额度" Checked="QuotaControlsChanged" Unchecked="QuotaControlsChanged"/><WrapPanel><TextBlock Text="额度方式" VerticalAlignment="Center" Margin="0,0,10,0"/><ComboBox x:Name="QuotaScope" SelectedIndex="0" Width="200" SelectionChanged="QuotaScopeChanged"><ComboBoxItem Content="全天共用一份额度"/><ComboBoxItem Content="分时段，每段独立额度"/></ComboBox></WrapPanel><WrapPanel x:Name="QuotaDailyFields"><TextBlock Text="每天共用" VerticalAlignment="Center"/><TextBox x:Name="QuotaMinutes" Text="30" Width="66" Margin="10,4,10,10"/><TextBlock Text="分钟（零点重置）" VerticalAlignment="Center"/></WrapPanel><StackPanel x:Name="QuotaTimeFields" Visibility="Collapsed"><Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/><ColumnDefinition Width="90"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions><TextBlock Text="时段名称"/><TextBlock Grid.Column="1" Text="开始"/><TextBlock Grid.Column="2" Text="结束"/><TextBlock Grid.Column="3" Text="额度/分钟"/></Grid><StackPanel x:Name="QuotaSlotsPanel"/><Button Content="＋ 添加独立额度时段" Click="AddQuotaSlot" HorizontalAlignment="Left"/></StackPanel><TextBlock x:Name="QuotaHint" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></Border>
          <WrapPanel><CheckBox x:Name="CycleEnabled" Content="循环计划"/><TextBlock Text="封锁" VerticalAlignment="Center"/><TextBox x:Name="BlockMinutes" Text="25" Width="60" Margin="6,4,6,10"/><TextBlock Text="分钟，休息" VerticalAlignment="Center"/><TextBox x:Name="RestMinutes" Text="5" Width="60" Margin="6,4,6,10"/><TextBlock Text="分钟" VerticalAlignment="Center"/></WrapPanel><TextBlock x:Name="CycleAnchor" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/>
          <TextBlock Text="倒计时封锁（任一条件命中即限制）" Style="{StaticResource Section}"/><WrapPanel><CheckBox x:Name="TimedEnabled" Content="提交后封锁"/><TextBox x:Name="TimedMinutes" Text="25" Width="70"/><TextBlock Text="分钟（改分钟数将重新确定截止时间）" VerticalAlignment="Center"/></WrapPanel><TextBlock Text="整份配置的修改等待" Style="{StaticResource Section}"/><WrapPanel><TextBlock Text="新配置的延迟" VerticalAlignment="Center"/><TextBox x:Name="DelayHours" Text="24" Width="70" Margin="10,4,8,10"/><ComboBox x:Name="DelayUnit" SelectedIndex="1" Width="85"><ComboBoxItem Content="分钟"/><ComboBoxItem Content="小时"/></ComboBox><ComboBox x:Name="TimeZone" SelectedIndex="0" Width="150" Margin="22,4,0,10"><ComboBoxItem Content="上海时间"/><ComboBoxItem Content="UTC"/></ComboBox></WrapPanel>
          <TextBlock x:Name="DelayNotice" Text="只有包含放宽的修改才等待。等待期间当前规则继续执行，到期自动切换；修改等待时间本身变短也属于放宽。" Foreground="{StaticResource Muted}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,12"/>
        </StackPanel></ScrollViewer>
      </DockPanel></Border>
    </Grid>
    <Border Grid.Row="3" Background="#E9EFF5" Padding="26,10"><TextBlock x:Name="Feedback" Text="正在连接专注计划后台…" TextWrapping="Wrap"/></Border>
  </Grid>
</Window>
