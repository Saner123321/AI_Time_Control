{
  "manifest_version": 3,
  "name": "专注计划 · 浏览器保护",
  "version": "0.3.0",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "declarativeNetRequest",
    "nativeMessaging",
    "tabs",
    "idle",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "专注计划浏览器保护"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "blocked.js",
        "gate.html",
        "gate.js",
        "reasons.js",
        "rules.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
